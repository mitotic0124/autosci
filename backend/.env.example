APP_NAME=AutoSci Quant AI Workflow
TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./autosci.db
ARTIFACTS_DIR=artifacts

ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_MAX_CANDIDATES=40
ARXIV_USER_AGENT=AutoSci/1.0
PAPER_COUNT=3
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0

# LLM (OpenAI-compatible API)
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=https://api.kimi.com/coding/v1
LLM_API_KEY=
LLM_MODEL=k3.1-pro
LLM_ARTICLE_MODEL=k3.1-pro
LLM_VISION_MODEL=k3.1-pro
LLM_VERIFIER_MODEL=k3.1-pro
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_OUTPUT_TOKENS=16384
LLM_THINKING_BUDGET=2048
LLM_REASONING_EFFORT=high
LLM_USE_RESPONSES_API=false
LLM_NOTE_SYSTEM_PROMPT=你是资深量化研究员。请使用准确、克制、证据导向的中文表达，严格区分论文原文结论与编辑解释，不补充未提供的事实、数字、建议或未来研究方向。
LLM_SCORE_SYSTEM_PROMPT=你是量化研究负责人。请仅输出 JSON 评分结果，不要添加解释。

# Evidence-grounded article pipeline
ARTICLE_FETCH_ARXIV_SOURCE=true
ARTICLE_MAX_SOURCE_CHARS=70000
ARTICLE_MAX_CLAIMS=42
ARTICLE_MAX_FIGURE_CANDIDATES=12
ARTICLE_MIN_IMAGES=1
ARTICLE_MAX_IMAGES=4
ARTICLE_MIN_FIGURE_SCORE=0.56
ARTICLE_QUALITY_THRESHOLD=0.90
ARTICLE_MAX_REPAIR_ATTEMPTS=2
ARTICLE_MAX_QUALITY_RETRIES=2
ARTICLE_PARALLEL_WORKERS=3
ARTICLE_REQUIRE_VERIFIED=true
ARTICLE_MIN_PARAGRAPHS=8
ARTICLE_MIN_SECTIONS=4
ARTICLE_MIN_CHARS=1800

# Backward-compatible fields (optional)
OPENAI_API_KEY=
OPENAI_MODEL=k3.1-pro

SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
MAIL_TO=

IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
COMMAND_POLL_INTERVAL_SECONDS=120
COMMAND_AUTHORIZED_SENDER=

ZHIHU_COLUMN_URL=https://zhuanlan.zhihu.com/write
ZHIHU_COLUMN_NAME=量化研究速递
ZHIHU_DEFAULT_TAGS=投资
ZHIHU_TOPIC_API_ENABLED=true
ZHIHU_TOPIC_MAX_COUNT=2
ZHIHU_TOPIC_MIN_RELEVANCE=0.45
ZHIHU_FIREFOX_PROFILE_PATH=
ZHIHU_HEADLESS=false
ZHIHU_PUBLISH_ENABLED=true
ZHIHU_AUTO_PUBLISH=false
ZHIHU_MAX_PUBLICATIONS_PER_DAY=1
ZHIHU_MIN_INTERACTION_INTERVAL_SECONDS=1800
WORKFLOW_AUTO_PUBLISH_AFTER_RUN=false

FRONTEND_ORIGIN=http://localhost:5173
