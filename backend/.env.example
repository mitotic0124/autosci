APP_NAME=AutoSci Quant AI Workflow
TIMEZONE=Asia/Shanghai
DATABASE_URL=sqlite:///./autosci.db
ARTIFACTS_DIR=artifacts

ARXIV_BASE_URL=http://export.arxiv.org/api/query
ARXIV_MAX_CANDIDATES=40
PAPER_COUNT=3
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0

# LLM (OpenAI-compatible API)
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_NOTE_SYSTEM_PROMPT=你是资深量化研究员。请输出结构化、可执行、证据导向的中文分析，重点覆盖方法论、数据说明、实证结论与风险。
LLM_SCORE_SYSTEM_PROMPT=你是量化研究负责人。请仅输出 JSON 评分结果，不要添加解释。

# Backward-compatible fields (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SMTP_HOST=smtp.163.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
MAIL_TO=

IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
COMMAND_POLL_INTERVAL_SECONDS=120
COMMAND_AUTHORIZED_SENDER=

ZHIHU_COLUMN_URL=https://zhuanlan.zhihu.com/write
ZHIHU_FIREFOX_PROFILE_PATH=
ZHIHU_HEADLESS=false
ZHIHU_PUBLISH_ENABLED=true

FRONTEND_ORIGIN=http://localhost:5173
